s yet unclassified' stamp: 'HernanWilkinson 8/11/2015 10:09'!digitConverters	^self class digitConverters! !!ArabigNumberToRomanStringConverter methodsFor: 'as yet unclassified' stamp: 'HernanWilkinson 8/11/2015 10:08'!initializeFor: aNumberToConvert	numberToConvert := aNumberToConvert! !!ArabigNumberToRomanStringConverter methodsFor: 'as yet unclassified' stamp: 'HernanWilkinson 8/11/2015 10:13'!value	^ String streamContents: [ :stream | 		self digitConverters do: [ :aDigitConverter | aDigitConverter value: numberToConvert into: stream ] ]	! !Object subclass: #DigitToRomanStringConverter	instanceVariableNames: 'divisor oneChar fiveChar tenChar'	classVariableNames: ''	poolDictionaries: ''	category: 'RomanNumbers'!!DigitToRomanStringConverter class methodsFor: 'instance creation' stamp: 'HernanWilkinson 8/10/2015 19:14'!dividingWith: aDivisor asOne: one asFive: five asTen: ten	^self new initializeDividingWith: aDivisor asOne: one asFive: five asTen: ten! !!DigitToRomanStringConverter methodsFor: 'as yet unclassified' stamp: 'HernanWilkinson 8/10/2015 19:14'!initializeDividingWith: aDivisor asOne: aOneChar asFive: aFiveChar asTen: aTenChar	divisor := aDivisor.	oneChar := aOneChar.	fiveChar := aFiveChar.	tenChar := aTenChar.	! !!DigitToRomanStringConverter methodsFor: 'as yet unclassified' stamp: 'HernanWilkinson 8/10/2015 19:16'!value: aNumber into: aStream	| digit |		digit := aNumber // divisor \\ 10.	(digit between: 1 and: 3) ifTrue: [digit timesRepeat: [ aStream nextPut: oneChar  ] ].	digit = 4 ifTrue: [ aStream nextPut: oneChar; nextPut: fiveChar ].	(digit between: 5 and: 8) ifTrue: [ 		aStream nextPut: fiveChar.		(digit - 5) timesRepeat: [ aStream nextPut: oneChar ] ].	digit = 9 ifTrue: [ aStream nextPut: oneChar; nextPut: tenChar ].! !!Integer methodsFor: '*RomanNumbers' stamp: 'HernanWilkinson 8/11/2015 10:06'!asRomanString	^ArabigNumberToRomanStringConverter convert: self! !TestCase subclass: #RomanNum